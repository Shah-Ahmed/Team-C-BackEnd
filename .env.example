# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or put real secrets in this example file.

# Firebase Admin config (from Service Account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID=

# CORS allowed frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Super admin credentials (used only by npm run seed:superadmin)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Google Gemini API key for AI content generation and sentiment analysis
GEMINI_API_KEY=

# Instagram Graph API credentials for live publishing and comment sync
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Facebook Page Graph API credentials for live publishing and comment sync
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
